{
  "rewrites": [
    { "source": "/kerja-sama", "destination": "/index.html" },
    { "source": "/laporan", "destination": "/index.html" },
    { "source": "/data", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/twin/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
